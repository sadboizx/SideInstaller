		<key>PayloadDisplayName</key>
		<string>SideInstaller</string>
		<key>PayloadDescription</key>
		<string>IMPORTANT: Once an app is installed, leave the DNS Profile exactly as it is — DNS must stay ON at all times. It is the only thing standing between these revoked certificates and Apple's servers: Disable OR Delete it your apps stop working. Likewise, Do not use a VPN — as VPN traffic bypasses the DNS filter and your apps may get revoked.</string>
		<key>PayloadOrganization</key>
		<string>No revokes!</string>
		<key>PayloadIdentifier</key>
		<string>sideinstaller-dnsSettings.managed.profiles</string>
		<key>PayloadRemovalDisallowed</key>
